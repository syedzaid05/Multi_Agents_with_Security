# ---------------------------------------------------------------------------
# Multi-Agent Research System - environment configuration
#
# Copy this file to `.env` and fill in the keys you have.
# The system runs in DEMO MODE with no keys at all (a deterministic local
# "echo" model answers), so you can explore the UI offline immediately.
#
# Prefer FREE tiers: Groq, Google Gemini, OpenRouter (":free" models) and
# local Ollama. See README.md for exact sign-up / auth commands.
# ---------------------------------------------------------------------------

# --- Free-tier providers (recommended order) -------------------------------
# Groq: https://console.groq.com/keys  (generous free tier)
GROQ_API_KEY=

# Google Gemini: https://aistudio.google.com/app/apikey  (free tier)
GOOGLE_API_KEY=

# OpenRouter: https://openrouter.ai/keys  (has many ":free" models)
OPENROUTER_API_KEY=

# --- Optional / paid providers ---------------------------------------------
# OpenAI (PAID): https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Together AI (mostly PAID, some free models): https://api.together.xyz
TOGETHER_API_KEY=

# Tavily web search (free tier available, then PAID): https://tavily.com
TAVILY_API_KEY=

# --- Local model server (free, no API key) ---------------------------------
# Ollama: https://ollama.com  ->  `ollama serve`  ->  `ollama pull llama3.2`
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama

# --- Web search backend: "duckduckgo" (free, no key) or "tavily" -----------
WEB_SEARCH_BACKEND=duckduckgo

# --- Runtime knobs ----------------------------------------------------------
# extra = show warnings for unknown fields instead of erroring
# Set to false if you want strict validation of LLM_ROUTES_JSON.
LOG_LEVEL=INFO
LOG_JSON=true
REQUEST_TIMEOUT_SECONDS=45
MAX_RETRIES=3
REQUESTS_PER_MINUTE=30
